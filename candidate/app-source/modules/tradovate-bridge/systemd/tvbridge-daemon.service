# Decrypt OS Tradovate bridge, login A: the daemon (loopback 8777). It waits up to 90 s for the
# browser's DevTools port, then attaches. It serves orders only after you sign in to Tradovate.
[Unit]
Description=Tradovate bridge daemon for login A (loopback 8777, DevTools 9555)
After=tvbridge-browser.service
StartLimitIntervalSec=600
StartLimitBurst=3
ConditionPathExists=%h/.local/share/decrypt-os/tvbridge/config.json

[Service]
Type=simple
WorkingDirectory=/usr/local/lib/decrypt-os/modules/tradovate-bridge/bridge
# This login's order token (TVBRIDGE_TOKEN), the other logins' read-only tokens and the Flatten-now token.
EnvironmentFile=%h/.local/share/decrypt-os/tvbridge/tvbridge.env
EnvironmentFile=-%h/.local/share/decrypt-os/tvbridge/logins/peers.env
EnvironmentFile=-%h/.local/share/decrypt-os/tvbridge/logins/manual-a.env
Environment=TVBRIDGE_ROOT=%h/.local/share/decrypt-os/tvbridge
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=150
ExecStart=/usr/bin/python3 /usr/local/lib/decrypt-os/modules/tradovate-bridge/bridge/scripts/start_daemon.py --config %h/.local/share/decrypt-os/tvbridge/config.json
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
