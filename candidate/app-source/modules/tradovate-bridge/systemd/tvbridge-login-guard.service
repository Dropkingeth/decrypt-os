# Decrypt OS Tradovate bridge, login A: one login-guard pass. It clicks Chromium's saved login and the
# Simulation button, within rate limits, and (re)starts this login's daemon. It never types or reads
# credentials and never trades. Weekend hold: see login-guard.json.
[Unit]
Description=Tradovate bridge login guard for login A (saved-login click; never types or trades)
After=tvbridge-browser.service
ConditionPathExists=%h/.local/share/decrypt-os/tvbridge/config.json

[Service]
Type=oneshot
# TVBRIDGE_TOKEN for the daemon's loopback /health. Optional: without it that check is skipped.
EnvironmentFile=-%h/.local/share/decrypt-os/tvbridge/tvbridge.env
Environment=TVBRIDGE_ROOT=%h/.local/share/decrypt-os/tvbridge
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/decrypt-os/modules/tradovate-bridge/login-guard/guard.py --run
UMask=0077
Nice=10
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any
MemoryMax=96M
TasksMax=16
TimeoutStartSec=90
StandardOutput=null
StandardError=journal
