  "modules": [
    {
      "id": "size-lock",
      "label": "Size Lock",
      "version": "1.0.0",
      "scope": "engine",
      "description": "Optional module for the Soup engine, off by default. Enabled: one contract, assigned to the original TP1 trigger, with the engine's original protective exits unchanged. Disabled (default): the existing original-allocation quantity policy, unchanged. There is no free-form or arbitrary fixed-N size; this module only switches between the engine's two reviewed quantity policies.",
      "packageStatus": "not_packaged",
      "runtimeSupported": true,
      "defaultEnabled": false,
      "sourceArtifacts": [
        {
          "role": "implementation",
          "sha256": "97506b265ed49db3bcdd6f01802e3b612bd5a1a1053a684df57eed469e97a753",
          "evidenceRef": "app/trading-runtime/decrypt_trading/runtime.py"
        }
      ],
      "compatibility": [
        {
          "sourcePairId": "soup-pine-authority-r4",
          "status": "supported",
          "reason": "Both quantity policies ('account-fixed-one-tp1-v1' and 'account-original-allocation-micro-cap-v1') are implemented in the paired Soup engine itself (vendor/soup_r4/core.py, validate_quantity_policy). This module only selects which one a held instance uses.",
          "sourcePairPins": {
            "engineSha256": "0a7803755e3e84c02f79252ef8938e093cc6a452715b49f7a2e29c1b86281d2a",
            "strategySha256": "32d09c04e6edec49ccb9c5d5f107d9ed43669c3bd60b89efebdf9b08f89b730f"
          }
        }
      ],
      "configurationFields": [
        {
          "key": "enabled",
          "label": "Enable Size Lock (one contract, original TP1)",
          "type": "boolean",
          "required": true,
          "help": "Off by default. Turning this on changes a held, idle/closed instance to the fixed-one-contract TP1-only quantity policy. Turning it off restores the original-allocation policy. The engine refuses to change this while a trade is active."
        }
      ],
      "defaultConfiguration": {
        "enabled": false
      }
    }
  ],
