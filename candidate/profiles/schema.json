{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decryptlabs.io/schemas/target-profile-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "arch",
    "hypervisors",
    "vmName",
    "hostname",
    "user",
    "disk",
    "partitionNaming",
    "liveRoot",
    "kernelPackage",
    "basePackages",
    "desktopPackageList",
    "network",
    "logChannel",
    "graphics",
    "password",
    "notice"
  ],
  "properties": {
    "schema": {
      "const": "decrypt.target-profile.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "kind": {
      "enum": [
        "qualification",
        "dryrun-loop",
        "image-build"
      ]
    },
    "arch": {
      "enum": [
        "aarch64",
        "x86_64"
      ]
    },
    "hypervisors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "vmName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "hostname": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "bytes"
      ],
      "properties": {
        "device": {
          "type": "string",
          "pattern": "^/dev/(?:[a-z]+[a-z0-9]*|nvme[0-9]+n[0-9]+)$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 512,
          "multipleOf": 512
        }
      }
    },
    "partitionNaming": {
      "enum": [
        "suffix",
        "p-suffix"
      ]
    },
    "liveRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedFsTypes",
        "requireRamBacked"
      ],
      "properties": {
        "allowedFsTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "requireRamBacked": {
          "type": "boolean"
        }
      }
    },
    "kernelPackage": {
      "enum": [
        "linux-aarch64",
        "linux"
      ]
    },
    "basePackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9+_.@-]*$"
      }
    },
    "desktopPackageList": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\s]+$"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phaseA",
        "phaseB",
        "policyId"
      ],
      "properties": {
        "phaseA": {
          "const": "offline"
        },
        "phaseB": {
          "enum": [
            "offline",
            "pinned-runtime-only"
          ]
        },
        "policyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      }
    },
    "logChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "uuid"
      ],
      "properties": {
        "kind": {
          "const": "log-disk"
        },
        "label": {
          "const": "DECRYPT_LOG"
        },
        "uuid": {
          "type": "null"
        }
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "softwareRendering"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "softwareRendering": {
          "type": "boolean"
        }
      }
    },
    "password": {
      "enum": [
        "native-prompt",
        "locked",
        "first-boot"
      ]
    },
    "notice": {
      "enum": [
        "interactive",
        "profile-accepted"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "qualification"
          }
        }
      },
      "then": {
        "properties": {
          "password": {
            "const": "native-prompt"
          },
          "liveRoot": {
            "properties": {
              "requireRamBacked": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dryrun-loop"
          }
        }
      },
      "then": {
        "properties": {
          "password": {
            "const": "locked"
          },
          "notice": {
            "const": "interactive"
          },
          "disk": {
            "properties": {
              "device": {
                "pattern": "^/dev/loop[0-9]+$"
              }
            }
          },
          "liveRoot": {
            "properties": {
              "requireRamBacked": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "image-build"
          }
        }
      },
      "then": {
        "properties": {
          "password": {
            "const": "first-boot"
          },
          "notice": {
            "const": "interactive"
          },
          "disk": {
            "properties": {
              "device": {
                "pattern": "^/dev/loop[0-9]+$"
              }
            }
          }
        }
      }
    }
  ]
}
